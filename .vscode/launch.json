{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FITY Backend (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "TEMP": "${workspaceFolder}/.cache/tmp",
        "TMP": "${workspaceFolder}/.cache/tmp",
        "MPLCONFIGDIR": "${workspaceFolder}/.cache/matplotlib"
      }
    }
  ]
}
